# Clerk configuration
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret_here

# Stream Video credentials for Webhook Signature Verification
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here

# Internal chatbot keys
AI_CHATBOT_INTERNAL_KEY=chatbot-internal-key-123

# Chatbot optimization
CHATBOT_RESPOND_CACHE_ENABLED=true
CHATBOT_RESPOND_INFLIGHT_DEDUP_ENABLED=true
CHATBOT_RESPOND_CACHE_TTL_MS=15000
CHATBOT_RESPOND_CACHE_MAX_ENTRIES=1000
CHATBOT_HTTP_KEEP_ALIVE=true
CHATBOT_HTTP_KEEP_ALIVE_MSECS=1000
CHATBOT_HTTP_MAX_SOCKETS=100
CHATBOT_HTTP_MAX_FREE_SOCKETS=20
CHATBOT_METRICS_ENABLED=true
CHATBOT_METRICS_WINDOW_SIZE=200
CHATBOT_METRICS_LOG_EVERY_N=50
