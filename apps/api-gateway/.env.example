CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Webhook Secret (from Clerk Dashboard > Webhooks)
# Used to verify webhook signatures from Clerk
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

GATEWAY_PORT=4000
USER_SOCIAL_SERVICE_PORT=4001
CONTENT_FEED_SERVICE_PORT=4002
SEARCH_RECOMMENDATION_SERVICE_PORT=4003
CHAT_SERVICE_PORT=4004
EMOTION_INTELLIGENCE_SERVICE_PORT=4005
CHATBOT_SERVICE_PORT=4006

REDIS_HOST=localhost
REDIS_PORT=6379


AI_CHATBOT_SERVICE_URL=http://localhost:4006
AI_CHATBOT_INTERNAL_KEY=chatbot-internal-key-123
CHATBOT_SERVICE_TIMEOUT_MS=10000
CHATBOT_CONTEXT_BUILD_TIMEOUT_MS=800
CHATBOT_DOWNSTREAM_MIN_TIMEOUT_MS=1000
CHATBOT_RESPOND_CACHE_ENABLED=true
CHATBOT_RESPOND_INFLIGHT_DEDUP_ENABLED=true
CHATBOT_RESPOND_CACHE_TTL_MS=15000
CHATBOT_RESPOND_CACHE_MAX_ENTRIES=1000
CHATBOT_HTTP_KEEP_ALIVE=true
CHATBOT_HTTP_KEEP_ALIVE_MSECS=1000
CHATBOT_HTTP_MAX_SOCKETS=100
CHATBOT_HTTP_MAX_FREE_SOCKETS=20
CHATBOT_METRICS_ENABLED=true
CHATBOT_METRICS_WINDOW_SIZE=200
CHATBOT_METRICS_LOG_EVERY_N=50

# Stream Video credentials for Webhook Signature Verification
STREAM_API_KEY=your-stream-api-key
STREAM_API_SECRET=your-stream-api-secret

# Observability
ENABLE_OTEL=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_PORT=5000




