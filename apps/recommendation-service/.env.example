HOST=0.0.0.0
PORT=4016

INTERNAL_SERVICE_KEY=recommendation-internal-key-123
RELOAD=true
RECOMMENDATION_MODEL_NAME=intfloat/multilingual-e5-base
RECOMMENDATION_MAX_LENGTH=256
RECOMMENDATION_BATCH_SIZE=16
RECOMMENDATION_MAX_CANDIDATES=100
RECOMMENDATION_SCORE_FLOOR=0.55
RECOMMENDATION_SCORE_CEILING=0.9
DATABASE_URL=postgresql://neondb_owner:
RECOMMENDATION_STATE_PROCESSOR_INTERVAL_SECONDS=30
RECOMMENDATION_QUERY_RERANK_TOP_K=25
RECOMMENDATION_QUERY_RERANK_TOP_K_CPU=8
RECOMMENDATION_EMBEDDING_CACHE_MAX_ENTRIES=5000
RECOMMENDATION_QUERY_CACHE_TTL_SECONDS=30
RECOMMENDATION_QUERY_CACHE_MAX_ENTRIES=1000
RECOMMENDATION_QUERY_SESSION_TTL_SECONDS=120
RECOMMENDATION_QUERY_SESSION_WINDOW_SIZE=200
RECOMMENDATION_QUERY_CACHE_REDIS_HOST=localhost
RECOMMENDATION_QUERY_CACHE_REDIS_PORT=6379
RECOMMENDATION_QUERY_CACHE_REDIS_DB=0
RECOMMENDATION_QUERY_CACHE_REDIS_PREFIX=recommendation:query-cache
RECOMMENDATION_QUERY_MODEL_WEIGHT=0.7
RECOMMENDATION_QUERY_RETRIEVAL_WEIGHT=0.3
RECOMMENDATION_QUERY_GRAPH_WEIGHT=0.15
RECOMMENDATION_MUTUAL_FRIEND_CAP=10
RECOMMENDATION_COMMON_GROUP_CAP=5
