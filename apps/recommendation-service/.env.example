RECOMMENDATION_GLOBAL_FALLBACK_REFRESH_INTERVAL_SECONDS=900
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=recommendation-service
KAFKA_GROUP_ID=recommendation-service-group
