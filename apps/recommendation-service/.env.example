HOST=0.0.0.0
PORT=4012

INTERNAL_SERVICE_KEY=recommendation-internal-key-123
RELOAD=true
RECOMMENDATION_MODEL_NAME=intfloat/multilingual-e5-base
RECOMMENDATION_MAX_LENGTH=256
RECOMMENDATION_BATCH_SIZE=16
RECOMMENDATION_MAX_CANDIDATES=100
RECOMMENDATION_SCORE_FLOOR=0.55
RECOMMENDATION_SCORE_CEILING=0.9
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recommendation_service
RECOMMENDATION_STATE_PROCESSOR_INTERVAL_SECONDS=30
RECOMMENDATION_PRECOMPUTE_TOP_K=50
RECOMMENDATION_PRECOMPUTE_BATCH_SIZE=20
RECOMMENDATION_PRECOMPUTED_MAX_AGE_SECONDS=300
RECOMMENDATION_QUERY_RERANK_TOP_K=25
RECOMMENDATION_QUERY_MODEL_WEIGHT=0.7
RECOMMENDATION_QUERY_RETRIEVAL_WEIGHT=0.3
RECOMMENDATION_GLOBAL_FALLBACK_TOP_K=500
RECOMMENDATION_GLOBAL_FALLBACK_REFRESH_INTERVAL_SECONDS=900
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=recommendation-service
KAFKA_GROUP_ID=recommendation-service-group
RECOMMENDATION_PROFILE_TOPIC=recommendation-profile-events
RECOMMENDATION_GRAPH_TOPIC=recommendation-graph-events
