MONGODB_URI=
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=4010
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE=create_notification_queue

# Call timeout and group policy
GROUP_CALL_MAX_PARTICIPANTS=10
GROUP_CALL_EMPTY_ROOM_TIMEOUT_MS=15000

# Stream Video media infra
STREAM_API_KEY=your-stream-api-key
STREAM_API_SECRET=your-stream-api-secret
STREAM_CALL_TYPE=default
STREAM_TOKEN_TTL_SEC=3600
# Optional base URL for client diagnostics, can be empty
STREAM_BASE_URL=

# Screen share policy
CALL_SCREEN_SHARE_ENABLED=true
CALL_SCREEN_SHARE_MODERATOR_ONLY=true

# Observability
ENABLE_OTEL=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_PORT=5010


