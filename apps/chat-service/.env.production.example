MONGODB_URI=mongodb://localhost:27017/se121_chat

# Call timeout and group policy
GROUP_CALL_MAX_PARTICIPANTS=10
GROUP_CALL_EMPTY_ROOM_TIMEOUT_MS=15000

# Stream Video media infra
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here
STREAM_CALL_TYPE=default
STREAM_TOKEN_TTL_SEC=3600
STREAM_BASE_URL=

# Screen share policy
CALL_SCREEN_SHARE_ENABLED=true
CALL_SCREEN_SHARE_MODERATOR_ONLY=true
