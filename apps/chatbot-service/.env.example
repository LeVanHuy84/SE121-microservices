HOST=0.0.0.0
PORT=4015
RELOAD=true
INTERNAL_SERVICE_KEY=chatbot-internal-key-123

CHATBOT_MAX_HISTORY_ITEMS=10
CHATBOT_MAX_CONTEXT_ITEMS=8
CHATBOT_CONTEXT_CHAR_LIMIT=1200
CHATBOT_SESSION_TTL_SECONDS=3600
ASSISTANT_DOCS_DIR=docs/assistant

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=8
RAG_INDEX_NAME=assistant_rag_documents
RAG_DOCS_ENABLED=true
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_DOC_TOP_K=5
ES_NODE=http://localhost:9200

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.2
