HOST=0.0.0.0
PORT=4015
RELOAD=true
INTERNAL_SERVICE_KEY=chatbot-internal-key-123

CHATBOT_MEMORY_RECENT_TURNS=8
CHATBOT_MEMORY_STORED_TURNS=16
CHATBOT_MEMORY_SUMMARY_CHAR_LIMIT=2500
CHATBOT_MAX_CONTEXT_ITEMS=5
CHATBOT_CONTEXT_CHAR_LIMIT=800
CHATBOT_CONTEXT_RESOLVE_TIMEOUT_MS=500
CHATBOT_METRICS_ENABLED=true
CHATBOT_METRICS_WINDOW_SIZE=200
CHATBOT_METRICS_LOG_EVERY_N=50
CHATBOT_PROMPT_HISTORY_ITEMS_MAX=3
CHATBOT_PROMPT_HISTORY_ITEM_CHAR_LIMIT=280
CHATBOT_PROMPT_CONTEXT_TOTAL_CHAR_LIMIT=1400
CHATBOT_PROMPT_AB_TEST_ENABLED=false
CHATBOT_PROMPT_AB_BUCKET_RATIO=0.5
CHATBOT_MAX_CONTEXT_ITEMS_A=5
CHATBOT_MAX_CONTEXT_ITEMS_B=4
CHATBOT_CONTEXT_CHAR_LIMIT_A=800
CHATBOT_CONTEXT_CHAR_LIMIT_B=650
CHATBOT_PROMPT_HISTORY_ITEMS_MAX_A=3
CHATBOT_PROMPT_HISTORY_ITEMS_MAX_B=3
CHATBOT_PROMPT_HISTORY_ITEM_CHAR_LIMIT_A=280
CHATBOT_PROMPT_HISTORY_ITEM_CHAR_LIMIT_B=220
CHATBOT_PROMPT_CONTEXT_TOTAL_CHAR_LIMIT_A=1400
CHATBOT_PROMPT_CONTEXT_TOTAL_CHAR_LIMIT_B=1600
CHATBOT_SESSION_TTL_SECONDS=3600
CHATBOT_REDIS_URL=redis://localhost:6379/0
CHATBOT_REDIS_CONNECT_TIMEOUT_SECONDS=0.5
CHATBOT_REDIS_SOCKET_TIMEOUT_SECONDS=0.5
CHATBOT_REDIS_RECONNECT_BACKOFF_SECONDS=5
CHATBOT_MEMORY_KEY_PREFIX=chatbot:assistant

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot_db
# Neon (asyncpg): use ssl=require (not sslmode) and optional prepared_statement_cache_size=0 for pooler
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<db>?ssl=require&prepared_statement_cache_size=0
CHATBOT_DB_ENABLED=true
CHATBOT_DB_ECHO=false
CHATBOT_DB_POOL_SIZE=10
CHATBOT_DB_MAX_OVERFLOW=20
CHATBOT_DB_POOL_TIMEOUT_SECONDS=5
CHATBOT_DB_POOL_RECYCLE_SECONDS=1800
CHATBOT_DB_COMMAND_TIMEOUT_SECONDS=8
CHATBOT_HISTORY_PAGE_SIZE_DEFAULT=20
CHATBOT_HISTORY_PAGE_SIZE_MAX=100
CHATBOT_HISTORY_PERSIST_TIMEOUT_MS=5000

ASSISTANT_DOCS_DIR=docs/assistant


CHATBOT_CONTEXT_CANDIDATE_POOL_SIZE=12
RAG_DOC_MAX_CHUNKS_PER_DOC=2
RAG_DOC_SEARCH_VISIBILITY=public
EMBEDDING_QUERY_CACHE_SIZE=256

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=8
RAG_INDEX_NAME=assistant_rag_documents
RAG_DOCS_ENABLED=true
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_DOC_TOP_K=4
RAG_REINDEX_MANIFEST_PATH=.cache/rag/.rag_index_manifest.sha256
RAG_WARMUP_ON_STARTUP=true
ES_NODE=http://localhost:9200

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
CHATBOT_LLM_TIMEOUT_MS=7000
GROQ_TIMEOUT_SECONDS=12
GROQ_MAX_TOKENS=256
GROQ_TEMPERATURE=0.2



