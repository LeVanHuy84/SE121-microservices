# Ports Configuration
GATEWAY_PORT=4000
USER_SOCIAL_SERVICE_PORT=4001
CONTENT_FEED_SERVICE_PORT=4002
SEARCH_RECOMMENDATION_SERVICE_PORT=4003
CHAT_SERVICE_PORT=4004
EMOTION_INTELLIGENCE_SERVICE_PORT=4005
CHATBOT_SERVICE_PORT=4006

# Infrastructure Hosts (Since we use host network mode, we connect via localhost)
REDIS_HOST=localhost
REDIS_PORT=6379
CHATBOT_REDIS_URL=redis://localhost:6379/0

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE=create_notification_queue

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=se121-microservices
KAFKA_GROUP_ID=se121-group
KAFKA_FROM_BEGINNING=false

ES_NODE=http://localhost:9200

# Chatbot AI API Keys (User should replace these with actual keys)
CHATBOT_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama provider (set CHATBOT_LLM_PROVIDER=ollama to use it)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

AI_CHATBOT_SERVICE_URL=http://localhost:4006
AI_CHATBOT_INTERNAL_KEY=chatbot-internal-key-123

# Environment & Logging
NODE_ENV=production
LOG_LEVEL=warn

# Observability & Production Infra Credentials (used with --env-file .env.production.local)
ENABLE_OTEL=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
GRAFANA_ADMIN_PASSWORD=change_me_strong_grafana_password

# Resilience & Timeouts (ms)
RPC_CLIENT_TIMEOUT_MS=10000
GATEWAY_RPC_TIMEOUT_MS=8000
GATEWAY_AI_TIMEOUT_MS=30000
