{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Kafka DLQ Messages (Total by Topic)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(kafka_dlq_messages_total) by (topic)",
          "legendFormat": "DLQ {{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 50 }
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Kafka Consumer Throughput & Errors",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(rpc_requests_total{transport=\"kafka\"}[5m])) by (job, status)",
          "legendFormat": "{{job}} ({{status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Error Logs Stream (Loki)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "{service=~\"$service\", level=\"error\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "All Service Logs (Loki)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "{service=~\"$service\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["se121", "kafka", "dlq", "logs"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "value": ["$__all"] },
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "definition": "label_values(up, job)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "service",
        "query": { "query": "label_values(up, job)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "title": "SE121 Messaging, DLQ & Logs",
  "uid": "se121-messaging-infra",
  "version": 1
}
