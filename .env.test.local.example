# ==============================================================================
# .env.test.local.example — Unified Local Testing Environment Template
# Copy this file to .env.test.local for local testing and load testing execution.
# ==============================================================================

# Core Ports
GATEWAY_TEST_PORT=4000
GATEWAY_METRICS_PORT=5000
USER_SOCIAL_TEST_PORT=4001
USER_SOCIAL_METRICS_PORT=5001
CONTENT_FEED_TEST_PORT=4002
CONTENT_FEED_METRICS_PORT=5002
SEARCH_REC_TEST_PORT=4003
SEARCH_REC_METRICS_PORT=5003
CHAT_TEST_PORT=4004
CHAT_METRICS_PORT=5004
EMOTION_TEST_PORT=4005
EMOTION_METRICS_PORT=5005
AI_CHATBOT_TEST_PORT=4006
AI_CHATBOT_METRICS_PORT=5006

# ==============================================================================
# 1. POSTGRESQL (Tách riêng từng CSDL cho từng Microservice)
# ==============================================================================
POSTGRES_TEST_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# user-social-service (Users, Friends, Social Graph)
USER_SOCIAL_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/user_social_service
USER_SOCIAL_POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/user_social_service

# content-feed-service (Postgres metadata nếu có)
CONTENT_FEED_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/content_feed_service
CONTENT_FEED_POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/content_feed_service

# search-recommendation-service (Music catalog & pgvector feature embeddings)
SEARCH_REC_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/search_recommendation
SEARCH_REC_POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/search_recommendation

# ==============================================================================
# 2. MONGODB (Tách riêng từng CSDL cho từng Microservice)
# ==============================================================================
MONGO_TEST_PORT=27017
MONGO_HOST=mongodb
MONGO_PORT=27017

# content-feed-service (Posts, Comments, Reactions, Feed Cache)
CONTENT_FEED_MONGODB_URI=mongodb://mongodb:27017/content_feed

# chat-service (Conversations, Messages, Outbox)
CHAT_MONGODB_URI=mongodb://mongodb:27017/chat_service

# emotion-intelligence-service (Emotion Logs, Daily Snapshots, Distress History)
EMOTION_MONGODB_URI=mongodb://mongodb:27017/emotion_intelligence

# ai-chatbot-service (Chatbot Sessions, Memory)
AI_CHATBOT_MONGO_URL=mongodb://mongodb:27017/ai_chatbot

# Generic fallback URIs cho các standalone test/seed scripts chạy từ root
MONGODB_URI=mongodb://mongodb:27017
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/user_social_service
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/user_social_service

# ==============================================================================
# 3. REDIS, KAFKA, RABBITMQ & ELASTICSEARCH
# ==============================================================================
REDIS_TEST_PORT=6379
REDIS_HOST=redis
REDIS_PORT=6379

KAFKA_BROKERS=kafka:9093
KAFKA_BOOTSTRAP_SERVERS=kafka:9093

RABBITMQ_HOST=rabbitmq
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_URL=http://elasticsearch:9200

# ==============================================================================
# 4. AUTHENTICATION & TEST FLAGS
# ==============================================================================
NODE_ENV=test
ENABLE_LOAD_TEST_MODE=true
ENABLE_MOCK_AUTH=true
# (CLERK_SECRET_KEY được kế thừa trực tiếp từ apps/user-social-service/.env, không ghi đè mock key tại đây)
STREAM_API_KEY=mock_stream_api_key
STREAM_API_SECRET=mock_stream_api_secret_for_testing_purposes_123456789
INTERNAL_SERVICE_KEY=chatbot-internal-key-123
X_INTERNAL_KEY=chatbot-internal-key-123
