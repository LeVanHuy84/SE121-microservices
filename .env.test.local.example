# ==============================================================================
# SE121 Microservices - Unified Test Environment Template (.env.test.local)
# ==============================================================================
# Sao chép file này thành .env.test.local ở thư mục root để chạy kiểm thử tải / E2E.
# File này đã được thêm vào .gitignore để đảm bảo an toàn thông tin.

NODE_ENV=test
ENABLE_LOAD_TEST_MODE=true
LOG_LEVEL=warn

# Observability (Tắt export tracing để tối đa hóa CPU cho việc đo throughput / RPS)
ENABLE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# Gateway & Service Ports
GATEWAY_PORT=4000
METRICS_PORT=5000

# Inter-Service Hostnames (Nội bộ mạng Docker Compose loadtest-network)
API_GATEWAY_HOST=api-gateway
CONTENT_FEED_SERVICE_HOST=content-feed-service
EMOTION_INTELLIGENCE_SERVICE_HOST=emotion-intelligence-service
USER_SOCIAL_SERVICE_HOST=user-social-service
SEARCH_RECOMMENDATION_SERVICE_HOST=search-recommendation-service
CHAT_SERVICE_HOST=chat-service
AI_CHATBOT_SERVICE_URL=http://ai-chatbot-service:4006

# Redis (Container redis-loadtest nội bộ)
REDIS_HOST=redis
REDIS_PORT=6379
POST_REDIS_HOST=redis
POST_REDIS_PORT=6379

# MongoDB (Container mongodb-loadtest nội bộ)
MONGODB_URI=mongodb://mongodb:27017

# PostgreSQL (Container postgres-loadtest nội bộ)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=user_social_service
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/user_social_service
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/user_social_service

# Kafka & RabbitMQ (Internal Docker ports)
KAFKA_BROKERS=kafka:9093
KAFKA_CLIENT_ID=loadtest-client
KAFKA_GROUP_ID=loadtest-group
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Mock Clerk & Internal Service Keys
CLERK_SECRET_KEY=mock_clerk_secret_key_for_test
AI_CHATBOT_INTERNAL_KEY=chatbot-internal-key-123
