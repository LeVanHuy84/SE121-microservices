{
  "name": "microservices",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start:dev": "turbo run start:dev --parallel --concurrency=12",
    "dev:test": "turbo run start:prod --parallel --concurrency=16",
    "demo": "turbo run start:dev --filter=api-gateway --filter=analysis-service --filter=user-service --filter=post-service --filter=group-service --filter=logging-service --filter=music-service --filter=emotion-intelligence-service",
    "demo:test": "turbo run start:prod --filter=analysis-service --filter=api-gateway --filter=feed-service",
    "recommend:dev": "turbo run start:dev --parallel --filter=user-service --filter=social-service --filter=group-service --filter=recommendation-service",
    "recommend:dev:gateway": "turbo run start:prod --parallel --filter=api-gateway --filter=user-service --filter=social-service --filter=group-service --filter=recommendation-service --filter=notification-service --filter=search-service",
    "assistant:dev": "turbo run start:dev --parallel --filter=api-gateway --filter=chatbot-service --filter=search-service",
    "video-call:dev": "turbo run start:prod  --filter=api-gateway --filter=social-service --filter=user-service --filter=notification-service --filter=chat-service",
    "recommend:report:live": "npm --workspace=social-service run test:recommend:live:report",
    "recommend:compare:live": "npm --workspace=social-service run test:recommend:live:compare",
    "group": "turbo run start:dev --filter=api-gateway --filter=group-service",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "seed:clerk": "node seed-data/clerk/create-clerk-users.js --limit=50",
    "seed:clerk:reset": "node seed-data/clerk/create-clerk-users.js --limit=50 --reset",
    "seed:clerk:reset-all": "node seed-data/clerk/create-clerk-users.js --reset-all",
    "seed:clerk:profiles": "node seed-data/clerk/update-profiles.js --limit=50 --seed=123",
    "seed:clerk:social": "node seed-data/clerk/simulate-social.js --limit=50 --rounds=2 --seed=123",
    "seed:chat": "ts-node -r tsconfig-paths/register --project apps/chat-service/tsconfig.json seed-data/seeds/seed-chat-service.ts",
    "seed:group": "ts-node -r tsconfig-paths/register --project apps/group-service/tsconfig.json seed-data/seeds/seed-group-service.ts",
    "seed:group-owner": "ts-node -r tsconfig-paths/register --project apps/group-service/tsconfig.json seed-data/seeds/update-group-owner-profile.ts",
    "seed:music": "ts-node -r tsconfig-paths/register --project apps/music-service/tsconfig.json seed-data/seeds/seed-music.ts",
    "seed:post": "ts-node -r tsconfig-paths/register --project apps/post-service/tsconfig.json seed-data/seeds/seed-post-service.ts",
    "seed:feed": "ts-node -r tsconfig-paths/register --project apps/feed-service/tsconfig.json seed-data/seeds/seed-feed-service.ts",
    "seed:search": "ts-node -r tsconfig-paths/register --project apps/search-service/tsconfig.json seed-data/seeds/seed-search-service.ts",
    "seed:emotion": "ts-node -r tsconfig-paths/register --project apps/emotion-intelligence-service/tsconfig.json seed-data/seeds/seed-emotion-intelligence-service.ts",
    "seed:sync-users": "ts-node -r tsconfig-paths/register --project apps/post-service/tsconfig.json seed-data/seeds/randomize-seed-users.ts"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dayjs": "^1.11.19",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.8.1",
    "kafkajs": "^2.2.4"
  }
}
