# Ignore dependency directories
node_modules
**/node_modules

# Ignore Python virtual environments
.venv
**/.venv
venv
**/venv
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd

# Ignore build outputs
dist
**/dist
build
**/build
.next
**/.next
.turbo
**/.turbo

# Ignore source control
.git
.gitignore
.github

# Ignore IDE settings and logs
.vscode
.idea
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment files
.env
.env.*
!.env.example
!.env.production.example

# Ignore heavy directories not needed for Docker build context
evaluation
**/evaluation
seed-data
tools
openapi
docs
.agent

# Large model and media files
*.onnx
*.bin
*.pt
*.pth
*.safetensors
*.zip
*.tar.gz
*.mp3
*.wav
*.flac
*.mp4

